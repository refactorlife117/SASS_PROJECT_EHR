# Copy to .env (repo root). Dev values only. All data in dev/staging is synthetic.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API / web -------------------------------------------------------------
API_PORT=4000
# Used by the Next.js dev proxy (/api/* -> API).
API_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Non-owner app role used by API + worker. Subject to RLS.
DATABASE_URL=postgresql://slotfill_app:slotfill_app@localhost:5433/slotfill
# Owner role. Used ONLY by Prisma Migrate (Phase 1+).
MIGRATE_DATABASE_URL=postgresql://slotfill_owner:slotfill_owner@localhost:5433/slotfill
# Test database (same roles).
TEST_DATABASE_URL=postgresql://slotfill_app:slotfill_app@localhost:5433/slotfill_test
TEST_MIGRATE_DATABASE_URL=postgresql://slotfill_owner:slotfill_owner@localhost:5433/slotfill_test

# --- Secrets (Phase 1+) ----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me
# 32-byte key, base64. AES-256-GCM field encryption (KMS data key in prod).
ENCRYPTION_KEY=change-me

# --- Messaging (Phase 3+) --------------------------------------------------
SMS_PROVIDER=dev
SMTP_HOST=localhost
SMTP_PORT=1025
DEV_SMS_EMAIL_TO=dev-sms@slotfill.local

# --- Deployment environment (Phase 7) -------------------------------------
# development | staging | production. Staging = production build + synthetic data + dev tools.
APP_ENV=development
# Email: smtp (Mailpit in dev) | ses (AWS). Used for password reset + staff alerts.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=SlotFill <no-reply@slotfill.local>
# AWS (only when SMS_PROVIDER=aws / EMAIL_TRANSPORT=ses)
AWS_REGION=us-east-1
# AWS_SMS_CONFIGURATION_SET=
# Comma-separated SNS topic ARNs allowed to deliver inbound SMS (required for SMS_PROVIDER=aws)
# AWS_SNS_INBOUND_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:slotfill-inbound
# In AWS, DATABASE_URL may be replaced by DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD(/DB_SSLMODE).
# DB bootstrap on managed Postgres: password for the slotfill_app role
# APP_DB_PASSWORD=

# --- DrChrono (Phase 8, optional) ------------------------------------------
# Register an API app at DrChrono; redirect URI = <APP_BASE_URL>/api/v1/ehr/drchrono/callback
# DRCHRONO_CLIENT_ID=
# DRCHRONO_CLIENT_SECRET=
# Secret token of the DrChrono webhook (verification + delivery header)
# DRCHRONO_WEBHOOK_SECRET=
# DRCHRONO_BASE_URL=https://app.drchrono.com

# --- Twilio (Phase 9, optional; ONLY with a signed Twilio BAA) -------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Deployed servers refuse Twilio unless this is true:
# TWILIO_BAA_SIGNED=false
