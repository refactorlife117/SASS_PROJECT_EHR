{
  "name": "@slotfill/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:server": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:bootstrap": "tsx --env-file-if-exists=../../.env prisma/bootstrap.ts",
    "db:release": "pnpm run db:bootstrap && prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "3.1169.0",
    "@aws-sdk/client-sesv2": "3.1169.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@slotfill/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "nodemailer": "10.5.0",
    "otplib": "13.6.0",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
